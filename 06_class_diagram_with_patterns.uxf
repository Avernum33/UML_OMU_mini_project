<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>8</zoom_level>

  <!-- ============================================================ -->
  <!--  PATTERN 1 : OBSERVER                                        -->
  <!-- ============================================================ -->
  <element>
    <id>UMLFrame</id>
    <coordinates><x>10</x><y>10</y><w>510</w><h>360</h></coordinates>
    <panel_attributes>«Pattern: Observer»</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- MenuSubject interface -->
  <element>
    <id>UMLClass</id>
    <coordinates><x>20</x><y>40</y><w>210</w><h>110</h></coordinates>
    <panel_attributes>&lt;&lt;interface&gt;&gt;
MenuSubject
--
--
+ attach(o: MenuObserver): void
+ detach(o: MenuObserver): void
+ notifyObservers(): void</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- MenuObserver interface -->
  <element>
    <id>UMLClass</id>
    <coordinates><x>280</x><y>40</y><w>210</w><h>90</h></coordinates>
    <panel_attributes>&lt;&lt;interface&gt;&gt;
MenuObserver
--
--
+ update(menu: Menu): void</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- AdminSystem (implements MenuSubject) -->
  <element>
    <id>UMLClass</id>
    <coordinates><x>20</x><y>200</y><w>220</w><h>150</h></coordinates>
    <panel_attributes>AdminSystem
--
- observers: List&lt;MenuObserver&gt;
- menu: Menu
- staffId: String
--
+ attach(o: MenuObserver): void
+ detach(o: MenuObserver): void
+ notifyObservers(): void
+ updatePrice(id, p): void
+ updateAvailability(id, b): void</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- Kiosk (implements MenuObserver) -->
  <element>
    <id>UMLClass</id>
    <coordinates><x>280</x><y>175</y><w>220</w><h>180</h></coordinates>
    <panel_attributes>Kiosk
--
- kioskId: String
- location: String
- localMenu: Menu
- payStrategy: PaymentStrategy
--
+ update(menu: Menu): void
+ displayMenu(): void
+ processOrder(): void
+ refreshLocalMenu(): void</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- AdminSystem implements MenuSubject (dashed + hollow arrow) -->
  <element>
    <id>Relation</id>
    <coordinates><x>120</x><y>140</y><w>30</w><h>70</h></coordinates>
    <panel_attributes>lt=.&lt;&lt;</panel_attributes>
    <additional_attributes>10;60;10;10</additional_attributes>
  </element>

  <!-- Kiosk implements MenuObserver -->
  <element>
    <id>Relation</id>
    <coordinates><x>380</x><y>120</y><w>30</w><h>65</h></coordinates>
    <panel_attributes>lt=.&lt;&lt;</panel_attributes>
    <additional_attributes>10;60;10;10</additional_attributes>
  </element>

  <!-- AdminSystem observes many Kiosk -->
  <element>
    <id>Relation</id>
    <coordinates><x>230</x><y>265</y><w>60</w><h>30</h></coordinates>
    <panel_attributes>lt=->
0..*</panel_attributes>
    <additional_attributes>10;10;50;10</additional_attributes>
  </element>

  <!-- ============================================================ -->
  <!--  PATTERN 2 : STRATEGY                                        -->
  <!-- ============================================================ -->
  <element>
    <id>UMLFrame</id>
    <coordinates><x>10</x><y>390</y><w>510</w><h>320</h></coordinates>
    <panel_attributes>«Pattern: Strategy»</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- PaymentStrategy interface -->
  <element>
    <id>UMLClass</id>
    <coordinates><x>160</x><y>415</y><w>200</w><h>90</h></coordinates>
    <panel_attributes>&lt;&lt;interface&gt;&gt;
PaymentStrategy
--
--
+ pay(amount: double): boolean
+ getDescription(): String</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- APCardPayment -->
  <element>
    <id>UMLClass</id>
    <coordinates><x>20</x><y>560</y><w>210</w><h>130</h></coordinates>
    <panel_attributes>APCardPayment
--
- cardId: String
- balance: double
--
+ pay(amount: double): boolean
+ deductBalance(a: double): void
+ getDescription(): String</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- QRCodePayment (future extension) -->
  <element>
    <id>UMLClass</id>
    <coordinates><x>280</x><y>560</y><w>210</w><h>130</h></coordinates>
    <panel_attributes>«future»
QRCodePayment
--
- qrToken: String
- sessionId: String
--
+ pay(amount: double): boolean
+ generateQR(): String
+ getDescription(): String</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- APCardPayment implements PaymentStrategy -->
  <element>
    <id>Relation</id>
    <coordinates><x>120</x><y>495</y><w>110</w><h>75</h></coordinates>
    <panel_attributes>lt=.&lt;&lt;</panel_attributes>
    <additional_attributes>90;70;10;10</additional_attributes>
  </element>

  <!-- QRCodePayment implements PaymentStrategy -->
  <element>
    <id>Relation</id>
    <coordinates><x>295</x><y>495</y><w>100</w><h>75</h></coordinates>
    <panel_attributes>lt=.&lt;&lt;</panel_attributes>
    <additional_attributes>10;70;80;10</additional_attributes>
  </element>

  <!-- Kiosk uses PaymentStrategy (dependency) -->
  <element>
    <id>Relation</id>
    <coordinates><x>370</x><y>345</y><w>110</w><h>80</h></coordinates>
    <panel_attributes>lt=.>
uses</panel_attributes>
    <additional_attributes>50;10;50;70</additional_attributes>
  </element>

  <!-- ============================================================ -->
  <!--  PATTERN 3 : SINGLETON                                       -->
  <!-- ============================================================ -->
  <element>
    <id>UMLFrame</id>
    <coordinates><x>550</x><y>10</y><w>230</w><h>430</h></coordinates>
    <panel_attributes>«Pattern: Singleton»</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- MenuManager Singleton -->
  <element>
    <id>UMLClass</id>
    <coordinates><x>560</x><y>40</y><w>210</w><h>190</h></coordinates>
    <panel_attributes>«singleton»
MenuManager
--
- instance: MenuManager {static}
- menu: Menu
- kiosks: List&lt;Kiosk&gt;
--
+ getInstance(): MenuManager {static}
+ getMenu(): Menu
+ updateMenu(m: Menu): void
+ broadcast(): void
+ registerKiosk(k: Kiosk): void
+ unregisterKiosk(k: Kiosk): void</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- self-reference (singleton) -->
  <element>
    <id>Relation</id>
    <coordinates><x>740</x><y>50</y><w>60</w><h>80</h></coordinates>
    <panel_attributes>lt=.>
instance</panel_attributes>
    <additional_attributes>10;10;50;10;50;60;10;60</additional_attributes>
  </element>

  <!-- TransactionLogger Singleton -->
  <element>
    <id>UMLClass</id>
    <coordinates><x>560</x><y>280</y><w>210</w><h>150</h></coordinates>
    <panel_attributes>«singleton»
TransactionLogger
--
- instance: TransactionLogger {static}
- logs: List&lt;LogEntry&gt;
--
+ getInstance(): TransactionLogger {static}
+ log(order: Order): void
+ getLogs(kioskId: String): List
+ exportLogs(): void</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- MenuManager --> Menu (manages) -->
  <element>
    <id>Relation</id>
    <coordinates><x>560</x><y>170</y><w>60</w><h>40</h></coordinates>
    <panel_attributes>lt=->
manages</panel_attributes>
    <additional_attributes>50;10;10;30</additional_attributes>
  </element>

  <!-- ============================================================ -->
  <!--  SHARED CORE CLASSES (bottom)                                -->
  <!-- ============================================================ -->

  <!-- Menu -->
  <element>
    <id>UMLClass</id>
    <coordinates><x>10</x><y>740</y><w>200</w><h>130</h></coordinates>
    <panel_attributes>Menu
--
- menuId: String
- products: List&lt;Product&gt;
- lastUpdated: Date
--
+ addProduct(p: Product): void
+ removeProduct(id: String): void
+ getProducts(): List&lt;Product&gt;
+ findById(id): Product</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- Order -->
  <element>
    <id>UMLClass</id>
    <coordinates><x>230</x><y>740</y><w>200</w><h>130</h></coordinates>
    <panel_attributes>Order
--
- orderId: String
- items: List&lt;OrderItem&gt;
- totalCost: double
- status: OrderStatus
- userId: String
--
+ submit(): void
+ calculateTotal(): double</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- Product (abstract) -->
  <element>
    <id>UMLClass</id>
    <coordinates><x>450</x><y>740</y><w>200</w><h>150</h></coordinates>
