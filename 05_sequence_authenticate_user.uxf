<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>8</zoom_level>

  <!-- Title -->
  <element>
    <id>UMLNote</id>
    <coordinates><x>220</x><y>0</y><w>280</w><h>30</h></coordinates>
    <panel_attributes>SD3 – Authenticate User</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ===== LIFELINE HEADS ===== -->
  <element>
    <id>UMLObject</id>
    <coordinates><x>20</x><y>40</y><w>110</w><h>40</h></coordinates>
    <panel_attributes>:User</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLObject</id>
    <coordinates><x>170</x><y>40</y><w>110</w><h>40</h></coordinates>
    <panel_attributes>:Kiosk</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLObject</id>
    <coordinates><x>330</x><y>40</y><w>140</w><h>40</h></coordinates>
    <panel_attributes>:AuthService</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLObject</id>
    <coordinates><x>520</x><y>40</y><w>110</w><h>40</h></coordinates>
    <panel_attributes>:UserDB</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ===== LIFELINES ===== -->
  <element>
    <id>SequenceDiagram</id>
    <coordinates><x>75</x><y>80</y><w>10</w><h>490</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>SequenceDiagram</id>
    <coordinates><x>225</x><y>80</y><w>10</w><h>490</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>SequenceDiagram</id>
    <coordinates><x>400</x><y>80</y><w>10</w><h>490</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>SequenceDiagram</id>
    <coordinates><x>575</x><y>80</y><w>10</w><h>490</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ===== MESSAGES ===== -->

  <!-- 1: swipeCard -->
  <element>
    <id>Relation</id>
    <coordinates><x>75</x><y>110</y><w>160</w><h>30</h></coordinates>
    <panel_attributes>lt=->
1: swipeCard(cardId)</panel_attributes>
    <additional_attributes>10;10;150;10</additional_attributes>
  </element>

  <!-- 2: authenticate -->
  <element>
    <id>Relation</id>
    <coordinates><x>225</x><y>145</y><w>185</w><h>30</h></coordinates>
    <panel_attributes>lt=->
2: authenticate(cardId)</panel_attributes>
    <additional_attributes>10;10;175;10</additional_attributes>
  </element>

  <!-- 3: findUser -->
  <element>
    <id>Relation</id>
    <coordinates><x>400</x><y>180</y><w>185</w><h>30</h></coordinates>
    <panel_attributes>lt=->
3: findUser(cardId)</panel_attributes>
    <additional_attributes>10;10;175;10</additional_attributes>
  </element>

  <!-- 4: userRecord (return) -->
  <element>
    <id>Relation</id>
    <coordinates><x>400</x><y>215</y><w>185</w><h>30</h></coordinates>
    <panel_attributes>lt=.>
4: userRecord</panel_attributes>
    <additional_attributes>175;10;10;10</additional_attributes>
  </element>

  <!-- 5: validateBalance (self) -->
  <element>
    <id>Relation</id>
    <coordinates><x>400</x><y>250</y><w>80</w><h>40</h></coordinates>
    <panel_attributes>lt=->
5: validateBalance()</panel_attributes>
    <additional_attributes>10;10;60;10;60;30;10;30</additional_attributes>
  </element>

  <!-- 6: authResult (return to kiosk) -->
  <element>
    <id>Relation</id>
    <coordinates><x>225</x><y>295</y><w>185</w><h>30</h></coordinates>
    <panel_attributes>lt=.>
6: authResult(user, balance)</panel_attributes>
    <additional_attributes>175;10;10;10</additional_attributes>
  </element>

  <!-- alt combined fragment -->
  <element>
    <id>UMLFrame</id>
    <coordinates><x>65</x><y>330</y><w>530</w><h>160</h></coordinates>
    <panel_attributes>alt
[balance &gt;= 0]
--
[else: insufficient balance]</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- 7a: displayWelcome -->
  <element>
    <id>Relation</id>
    <coordinates><x>75</x><y>365</y><w>160</w><h>30</h></coordinates>
    <panel_attributes>lt=.>
7a: displayWelcome(name, balance)</panel_attributes>
    <additional_attributes>150;10;10;10</additional_attributes>
  </element>

  <!-- 7b: displayError -->
  <element>
    <id>Relation</id>
    <coordinates><x>75</x><y>450</y><w>160</w><h>30</h></coordinates>
    <panel_attributes>lt=.>
7b: displayError("Insufficient balance")</panel_attributes>
    <additional_attributes>150;10;10;10</additional_attributes>
  </element>

</diagram>
