<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>8</zoom_level>

  <!-- Title -->
  <element>
    <id>UMLNote</id>
    <coordinates><x>200</x><y>0</y><w>320</w><h>30</h></coordinates>
    <panel_attributes>SD2 – Update Menu (Admin)</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ===== LIFELINE HEADS ===== -->
  <element>
    <id>UMLObject</id>
    <coordinates><x>20</x><y>40</y><w>130</w><h>40</h></coordinates>
    <panel_attributes>:AdminSystem</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLObject</id>
    <coordinates><x>190</x><y>40</y><w>110</w><h>40</h></coordinates>
    <panel_attributes>:Menu</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLObject</id>
    <coordinates><x>340</x><y>40</y><w>110</w><h>40</h></coordinates>
    <panel_attributes>:Product</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLObject</id>
    <coordinates><x>490</x><y>40</y><w>110</w><h>40</h></coordinates>
    <panel_attributes>:Kiosk[1]</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLObject</id>
    <coordinates><x>640</x><y>40</y><w>110</w><h>40</h></coordinates>
    <panel_attributes>:Kiosk[n]</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ===== LIFELINES ===== -->
  <element>
    <id>SequenceDiagram</id>
    <coordinates><x>85</x><y>80</y><w>10</w><h>530</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>SequenceDiagram</id>
    <coordinates><x>245</x><y>80</y><w>10</w><h>530</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>SequenceDiagram</id>
    <coordinates><x>395</x><y>80</y><w>10</w><h>530</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>SequenceDiagram</id>
    <coordinates><x>545</x><y>80</y><w>10</w><h>530</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>SequenceDiagram</id>
    <coordinates><x>695</x><y>80</y><w>10</w><h>530</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ===== MESSAGES ===== -->

  <!-- 1: updatePrice (self call / entry) -->
  <element>
    <id>Relation</id>
    <coordinates><x>85</x><y>110</y><w>80</w><h>40</h></coordinates>
    <panel_attributes>lt=->
1: updatePrice(productId, newPrice)</panel_attributes>
    <additional_attributes>10;10;60;10;60;30;10;30</additional_attributes>
  </element>

  <!-- 2: findProduct -->
  <element>
    <id>Relation</id>
    <coordinates><x>85</x><y>155</y><w>170</w><h>30</h></coordinates>
    <panel_attributes>lt=->
2: findProduct(productId)</panel_attributes>
    <additional_attributes>10;10;160;10</additional_attributes>
  </element>

  <!-- 3: setPrice -->
  <element>
    <id>Relation</id>
    <coordinates><x>245</x><y>190</y><w>160</w><h>30</h></coordinates>
    <panel_attributes>lt=->
3: setPrice(newPrice)</panel_attributes>
    <additional_attributes>10;10;150;10</additional_attributes>
  </element>

  <!-- 4: persist (self) -->
  <element>
    <id>Relation</id>
    <coordinates><x>395</x><y>225</y><w>80</w><h>40</h></coordinates>
    <panel_attributes>lt=->
4: persist()</panel_attributes>
    <additional_attributes>10;10;60;10;60;30;10;30</additional_attributes>
  </element>

  <!-- 5: updated (return) -->
  <element>
    <id>Relation</id>
    <coordinates><x>245</x><y>270</y><w>160</w><h>30</h></coordinates>
    <panel_attributes>lt=.>
5: updated: boolean</panel_attributes>
    <additional_attributes>150;10;10;10</additional_attributes>
  </element>

  <!-- 6: setLastUpdated (self on Menu) -->
  <element>
    <id>Relation</id>
    <coordinates><x>245</x><y>305</y><w>80</w><h>40</h></coordinates>
    <panel_attributes>lt=->
6: setLastUpdated(now)</panel_attributes>
    <additional_attributes>10;10;60;10;60;30;10;30</additional_attributes>
  </element>

  <!-- 7: menuUpdated (return to admin) -->
  <element>
    <id>Relation</id>
    <coordinates><x>85</x><y>350</y><w>170</w><h>30</h></coordinates>
    <panel_attributes>lt=.>
7: menuUpdated</panel_attributes>
    <additional_attributes>160;10;10;10</additional_attributes>
  </element>

  <!-- loop box -->
  <element>
    <id>UMLFrame</id>
    <coordinates><x>460</x><y>375</y><w>290</w><h>120</h></coordinates>
    <panel_attributes>loop
[for each connected Kiosk]</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- 8a: notify Kiosk[1] -->
  <element>
    <id>Relation</id>
    <coordinates><x>85</x><y>400</y><w>470</w><h>30</h></coordinates>
    <panel_attributes>lt=->
8: notifyMenuChanged(updatedMenu)</panel_attributes>
    <additional_attributes>10;10;460;10</additional_attributes>
  </element>

  <!-- 8b: notify Kiosk[n] -->
  <element>
    <id>Relation</id>
    <coordinates><x>85</x><y>440</y><w>620</w><h>30</h></coordinates>
    <panel_attributes>lt=->
8: notifyMenuChanged(updatedMenu)</panel_attributes>
    <additional_attributes>10;10;610;10</additional_attributes>
  </element>

  <!-- 9: ack -->
  <element>
    <id>Relation</id>
    <coordinates><x>85</x><y>480</y><w>470</w><h>30</h></coordinates>
    <panel_attributes>lt=.>
9: ack()</panel_attributes>
    <additional_attributes>460;10;10;10</additional_attributes>
  </element>

</diagram>
