<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>8</zoom_level>

  <!-- System boundary -->
  <element>
    <id>UMLFrame</id>
    <coordinates><x>160</x><y>20</y><w>440</w><h>620</h></coordinates>
    <panel_attributes>APU Kiosk System</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ===== ACTORS ===== -->
  <!-- Student -->
  <element>
    <id>UMLActor</id>
    <coordinates><x>20</x><y>140</y><w>80</w><h>100</h></coordinates>
    <panel_attributes>Student</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- Staff / Lecturer -->
  <element>
    <id>UMLActor</id>
    <coordinates><x>20</x><y>360</y><w>80</w><h>100</h></coordinates>
    <panel_attributes>Staff /
Lecturer</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- Admin / Staff (booth) -->
  <element>
    <id>UMLActor</id>
    <coordinates><x>640</x><y>430</y><w>80</w><h>100</h></coordinates>
    <panel_attributes>Admin /
Staff</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ===== USE CASES – Kiosk ===== -->
  <element>
    <id>UMLUseCase</id>
    <coordinates><x>220</x><y>60</y><w>240</w><h>50</h></coordinates>
    <panel_attributes>Identify user /
check balance</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLUseCase</id>
    <coordinates><x>240</x><y>130</y><w>200</w><h>50</h></coordinates>
    <panel_attributes>Browse menu</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLUseCase</id>
    <coordinates><x>220</x><y>200</y><w>240</w><h>50</h></coordinates>
    <panel_attributes>Customise drink / snack</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLUseCase</id>
    <coordinates><x>240</x><y>270</y><w>200</w><h>50</h></coordinates>
    <panel_attributes>Place order</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLUseCase</id>
    <coordinates><x>220</x><y>340</y><w>240</w><h>50</h></coordinates>
    <panel_attributes>Deduct card balance</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLUseCase</id>
    <coordinates><x>240</x><y>410</y><w>200</w><h>50</h></coordinates>
    <panel_attributes>Log transaction</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ===== USE CASES – Admin ===== -->
  <element>
    <id>UMLUseCase</id>
    <coordinates><x>420</x><y>480</y><w>230</w><h>50</h></coordinates>
    <panel_attributes>Receive order notification</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLUseCase</id>
    <coordinates><x>410</x><y>545</y><w>250</w><h>50</h></coordinates>
    <panel_attributes>Update price /
availability</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLUseCase</id>
    <coordinates><x>415</x><y>610</y><w>240</w><h>50</h></coordinates>
    <panel_attributes>Broadcast menu changes</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ===== ASSOCIATIONS – Student ===== -->
  <element>
    <id>Relation</id>
    <coordinates><x>80</x><y>80</y><w>150</w><h>110</h></coordinates>
    <panel_attributes>lt=-</panel_attributes>
    <additional_attributes>10;90;130;10</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>80</x><y>140</y><w>170</w><h>40</h></coordinates>
    <panel_attributes>lt=-</panel_attributes>
    <additional_attributes>10;20;150;20</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>80</x><y>160</y><w>150</w><h>80</h></coordinates>
    <panel_attributes>lt=-</panel_attributes>
    <additional_attributes>10;10;130;70</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>80</x><y>160</y><w>170</w><h>150</h></coordinates>
    <panel_attributes>lt=-</panel_attributes>
    <additional_attributes>10;10;150;140</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>80</x><y>160</y><w>150</w><h>220</h></coordinates>
    <panel_attributes>lt=-</panel_attributes>
    <additional_attributes>10;10;130;210</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>80</x><y>160</y><w>170</w><h>295</h></coordinates>
    <panel_attributes>lt=-</panel_attributes>
    <additional_attributes>10;10;150;285</additional_attributes>
  </element>

  <!-- ===== ASSOCIATIONS – Staff (dashed to show secondary actor) ===== -->
  <element>
    <id>Relation</id>
    <coordinates><x>80</x><y>80</y><w>150</w><h>330</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes>10;320;130;10</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>80</x><y>140</y><w>170</w><h>280</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes>10;270;150;10</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>80</x><y>200</y><w>150</w><h>230</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes>10;220;130;10</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>80</x><y>270</y><w>170</w><h>160</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes>10;150;150;10</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>80</x><y>340</y><w>150</w><h>90</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes>10;80;130;10</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>80</x><y>390</y><w>170</w><h>60</h></coordinates>
    <panel_attributes>lt=.</panel_attributes>
    <additional_attributes>10;50;150;10</additional_attributes>
  </element>

  <!-- ===== ASSOCIATIONS – Admin ===== -->
  <element>
    <id>Relation</id>
    <coordinates><x>630</x><y>480</y><w>60</w><h>50</h></coordinates>
    <panel_attributes>lt=-</panel_attributes>
    <additional_attributes>50;10;10;40</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>630</x><y>530</y><w>60</w><h>50</h></coordinates>
    <panel_attributes>lt=-</panel_attributes>
    <additional_attributes>50;10;10;40</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>630</x><y>580</y><w>60</w><h>60</h></coordinates>
    <panel_attributes>lt=-</panel_attributes>
    <additional_attributes>50;10;10;50</additional_attributes>
  </element>

  <!-- «include» Place order → Deduct balance -->
  <element>
    <id>Relation</id>
    <coordinates><x>330</x><y>310</y><w>40</w><h>50</h></coordinates>
    <panel_attributes>lt=.>
«include»</panel_attributes>
    <additional_attributes>10;10;10;40</additional_attributes>
  </element>

  <!-- «include» Place order → Log transaction -->
  <element>
    <id>Relation</id>
    <coordinates><x>330</x><y>295</y><w>80</w><h>130</h></coordinates>
    <panel_attributes>lt=.>
«include»</panel_attributes>
    <additional_attributes>10;10;30;120</additional_attributes>
  </element>

  <!-- «extend» Browse menu → Customise -->
  <element>
    <id>Relation</id>
    <coordinates><x>330</x><y>175</y><w>40</w><h>40</h></coordinates>
    <panel_attributes>lt=.>
«extend»</panel_attributes>
    <additional_attributes>10;10;10;30</additional_attributes>
  </element>

</diagram>
