@startuml use-case-kiosk-system
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Student / Staff\nCustomer" as Customer
actor "Snack Booth\nAdmin Staff" as Admin
actor "Preparation\nStaff" as Prep
actor "AP Card\nService" as CardService

rectangle "Campus Drinks and Snack Ordering Kiosk System" {
  usecase "Identify user" as UC1
  usecase "Browse drinks\nand snacks" as UC2
  usecase "Customize item" as UC3
  usecase "Place order" as UC4
  usecase "Pay by AP card" as UC5
  usecase "Deduct card\nbalance" as UC6
  usecase "Notify preparation\narea" as UC7
  usecase "Log transaction" as UC8
  usecase "Update product\nprice/availability" as UC9
  usecase "Synchronize\nkiosks" as UC10
  usecase "View incoming\norders" as UC11
}

Customer --> UC1
Customer --> UC2
Customer --> UC3
Customer --> UC4
Customer --> UC5

UC4 .> UC1 : <<include>>
UC4 .> UC3 : <<include>>
UC4 .> UC5 : <<include>>
UC4 .> UC7 : <<include>>
UC4 .> UC8 : <<include>>
UC5 .> UC6 : <<include>>

CardService --> UC1
CardService --> UC6

Admin --> UC9
UC9 .> UC10 : <<include>>

Prep --> UC11
UC7 .> UC11 : <<include>>
@enduml

